# Cleanverse sandbox API credentials - server-only, used by app/lib/cleanverse.server.ts.
# Never prefix these with NEXT_PUBLIC_ - they must never reach the browser bundle.
CLEANVERSE_API_ID=
CLEANVERSE_API_KEY=

# Demo backend signer (pool owner) - server-only, used by app/lib/serverChain.server.ts
# to call AvalLending.openCreditLineFor on the user's behalf. Never prefix with NEXT_PUBLIC_.
PRIVATE_KEY=

# Monad testnet RPC endpoint. Optional - defaults to https://testnet-rpc.monad.xyz if unset.
# NEXT_PUBLIC_ on purpose: this isn't a secret, and wagmi needs it in the browser bundle too.
NEXT_PUBLIC_MONAD_RPC_URL=https://testnet-rpc.monad.xyz
